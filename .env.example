# Chaîne de connexion à la base PostgreSQL
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HÔTE:PORT/BASE?schema=SCHEMA
# Ces valeurs correspondent au conteneur Docker décrit dans le README (port 5433)
DATABASE_URL="postgresql://user:password@localhost:5433/mdd_db?schema=public"

# Configuration Auth.js (NextAuth v5)
# Générer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="remplacez-moi-par-un-secret-genere"
AUTH_URL="http://localhost:3000"